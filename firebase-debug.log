[debug] [2026-09-01T10:17:09.432Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/literakar-journal/rulesets {"name":"projects/literakar-journal/rulesets/e1ad2477-1fc6-403a-b199-2e00a6b22137","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function isSignedIn() {\n      return request.auth != null;\n    }\n\n    // Aman terhadap dokumen yang belum/tidak ada — tidak akan throw error.\n    function currentUserExists() {\n      return isSignedIn()\n        && exists(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    function currentUser() {\n      return get(/databases/$(database)/documents/users/$(request.auth.uid));\n    }\n\n    function hasRole(role) {\n      return currentUserExists() && currentUser().data.role == role;\n    }\n\n    function isStudent() {\n      return hasRole('student');\n    }\n\n    function isTeacher() {\n      return hasRole('teacher');\n    }\n\n    function isAdmin() {\n      return hasRole('admin');\n    }\n\n    function isStaff() {\n      return isTeacher() || isAdmin();\n    }\n\n    match /users/{userId} {\n      // Self-read dicek DULUAN (tidak butuh get() tambahan), baru staff-check.\n      allow read: if (isSignedIn() && request.auth.uid == userId) || isStaff();\n\n      // Public registration can create a student or teacher for the authenticated UID.\n      allow create: if isSignedIn()\n        && request.auth.uid == userId\n        && request.resource.data.uid == userId\n        && request.resource.data.role in ['student', 'teacher'];\n\n      // Staff can edit profile data but cannot change UID or role.\n      allow update: if isAdmin()\n        || (\n          isTeacher()\n          && resource.data.role == 'student'\n          && request.resource.data.role == resource.data.role\n          && request.resource.data.uid == resource.data.uid\n        )\n        || (\n          isSignedIn()\n          && request.auth.uid == userId\n          && request.resource.data.role == resource.data.role\n          && request.resource.data.uid == resource.data.uid\n        );\n\n      allow delete: if isAdmin() || (isTeacher() && resource.data.role == 'student');\n    }\n\n    match /journals/{journalId} {\n      allow read: if isStaff()\n        || isStudent();\n\n      allow create: if isStudent()\n        && request.resource.data.studentId == request.auth.uid\n        && request.resource.data.status == 'pending';\n\n      // Teachers validate and annotate; admins may manage any journal field.\n      allow update: if isAdmin()\n        || (\n          isTeacher()\n          && request.resource.data.studentId == resource.data.studentId\n          && request.resource.data.diff(resource.data).affectedKeys()\n            .hasOnly(['status', 'teacherFeedback', 'studentName', 'classCode', 'approvedBy', 'updatedAt', 'progressLog'])\n        )\n        || (\n          isStudent()\n          && resource.data.studentId == request.auth.uid\n          && request.resource.data.studentId == resource.data.studentId\n          && (\n            (\n              resource.data.status in ['pending', 'revision']\n              && request.resource.data.status == 'pending'\n              && request.resource.data.diff(resource.data).affectedKeys()\n                .hasOnly([\n                  'bookTitle', 'author', 'genre', 'startPage', 'endPage', 'summary',\n                  'characterValues', 'finished', 'status', 'teacherFeedback',\n                  'progressLog', 'updatedAt'\n                ])\n            )\n            || (\n              resource.data.status == 'approved'\n              && request.resource.data.status == resource.data.status\n              && request.resource.data.diff(resource.data).affectedKeys()\n                .hasOnly(['progressLog', 'updatedAt'])\n            )\n          )\n        );\n\n      allow delete: if isStaff();\n    }\n  }\n}","name":"firestore.rules"}]},"createTime":"2026-09-01T10:17:10.798911Z","metadata":{"services":["cloud.firestore"]}}
